{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/server.js",
            "methods": ["GET", "POST", "DELETE"]
        },
        {
            "src": "/main/(.+)",
            "dest": "/public/main/$1",
            "headers": {
                "Content-Type": "text/html"
            }
        },
        {
            "src": "/css/(.+)",
            "dest": "/public/css/$1",
            "headers": {
                "Content-Type": "text/css"
            }
        },
        {
            "src": "/js/(.+)",
            "dest": "/public/js/$1",
            "headers": {
                "Content-Type": "application/javascript"
            }
        },
        {
            "src": "/assets/(.+)",
            "dest": "/public/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/public/$1",
            "methods": ["GET"],
            "headers": {
                "Content-Type": "text/html"
            },
            "continue": true
        },
        {
            "src": "/",
            "dest": "/public/index.html",
            "headers": {
                "Content-Type": "text/html"
            }
        }
    ]
}
